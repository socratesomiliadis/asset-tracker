{
  "name": "asset-tracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "pnpm --filter @asset-tracker/shared build && concurrently -n shared,frontend,backend -c yellow,cyan,magenta \"pnpm --filter @asset-tracker/shared dev\" \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:push": "pnpm --filter backend db:push"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
